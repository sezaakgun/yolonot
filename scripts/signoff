#!/bin/sh
# Sign off native and containerized harness checks for the current commit.
#
#   scripts/signoff [--dry-run] [--manual] [--skip "reason"] <check>... | docker | desktop | all
#
# Each check runs its e2e tests (or drives the macOS desktop app automatically,
# falling back to e2e/MANUAL.md when --manual is set or Accessibility is absent)
# and posts a GitHub commit status on HEAD: e2e/<check> or
# manual/<check>. A status belongs to one SHA, so any new push needs a new
# sign-off. --skip posts success with the reason visible on the PR.
set -eu

NATIVE="claude-cli claude-mod codex opencode agy cursor-cli"
DOCKER="crush goose qwen kilo pi openhands kimi zcode cline grok copilot kiro mirror openclaw amp hermes deepseek devin muse"
MANUAL="claude-desktop codex-desktop cursor-ide"
ALL="$NATIVE $DOCKER $MANUAL"
cd "$(git rev-parse --show-toplevel)"

dry=0
force_manual=0
skip=""
while [ $# -gt 0 ]; do
	case "$1" in
	--dry-run) dry=1; shift ;;
	--manual) force_manual=1; shift ;;
	--skip) skip="${2:-}"; [ -n "$skip" ] || { echo "--skip needs a reason" >&2; exit 2; }; shift 2 ;;
	-*) echo "unknown flag $1" >&2; exit 2 ;;
	*) break ;;
	esac
done
[ $# -gt 0 ] || { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; echo "checks: $ALL"; exit 2; }
expanded=""
for arg in "$@"; do
	case "$arg" in
	all) expanded="$expanded $ALL" ;;
	docker) expanded="$expanded $DOCKER" ;;
	desktop) expanded="$expanded $MANUAL" ;;
	*) expanded="$expanded $arg" ;;
	esac
done
# shellcheck disable=SC2086 # split expanded check names into arguments
set -- $expanded

sha=$(git rev-parse HEAD)
repo=""
[ $dry = 1 ] || repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)

# The status must describe exactly this commit: no tracked changes and no
# untracked Go or e2e files that the tests would pick up.
dirty=$(git status --porcelain --untracked-files=no; git ls-files --others --exclude-standard -- '*.go' 'e2e/*' 'scripts/*' go.mod go.sum)
if [ -n "$dirty" ]; then
	echo "working tree differs from $sha:" >&2
	echo "$dirty" >&2
	[ $dry = 1 ] || exit 1
	echo "(dry run: continuing)" >&2
fi
if [ $dry = 0 ] && ! gh api "repos/$repo/commits/$sha" --silent 2>/dev/null; then
	echo "$sha is not on GitHub; push it first" >&2
	exit 1
fi

trim() { printf '%s' "$1" | sed 's/^ *//; s/ *$//'; }

bin() { # host binary, honouring the same YOLONOT_E2E_<NAME> override as the tests
	var=YOLONOT_E2E_$(echo "$1" | tr 'a-z-' 'A-Z_')
	eval "echo \${$var:-$1}"
}

version() { # in a throwaway HOME: some hosts write config on any run
	vhome=$(mktemp -d)
	HOME=$vhome XDG_CONFIG_HOME=$vhome/.config XDG_DATA_HOME=$vhome/.local/share \
		XDG_CACHE_HOME=$vhome/.cache XDG_STATE_HOME=$vhome/.local/state \
		"$(bin "$1")" --version 2>/dev/null | head -1 | tr -s ' ' | cut -c1-60
	rm -rf "$vhome"
}

post() { # context state description
	desc=$(printf '%s' "$3" | cut -c1-140)
	echo "$1: $2 ($desc)"
	[ $dry = 1 ] && return
	gh api -X POST "repos/$repo/statuses/$sha" -f state="$2" -f context="$1" -f description="$desc" --silent
}

run_tests() { # context host regex [auth]
	ctx=$1 host=$2 regex=$3
	ver=$(version "$host") || ver=""
	[ -n "$ver" ] || { post "$ctx" failure "$host not found"; return 1; }
	log=$(mktemp)
	set +e
	env ${4:+YOLONOT_E2E_AUTH=1} go test -tags e2e ./e2e/ -run "$regex" -count=1 -v >"$log" 2>&1
	rc=$?
	set -e
	pass=$(grep -c '^ *--- PASS' "$log" || true)
	if grep -q '^ *--- SKIP' "$log"; then
		grep '^ *--- SKIP' "$log" >&2
		post "$ctx" failure "$ver: tests skipped"
		return 1
	fi
	if [ $rc != 0 ] || [ "$pass" = 0 ]; then
		grep -E '^ *--- FAIL|_test.go' "$log" | head -20 >&2
		echo "full log: $log" >&2
		post "$ctx" failure "$ver: e2e failed"
		return 1
	fi
	rm -f "$log"
	post "$ctx" success "$ver: $pass passed"
}

docker_regex() { # check → E2E test regex inside yolonot-e2e container
	case "$1" in
	crush) echo 'TestCrushCLI' ;;
	goose) echo 'TestGooseCLI' ;;
	qwen) echo 'TestQwenCLI' ;;
	kilo) echo 'TestKiloCLI|TestKiloPluginRuntime' ;;
	pi) echo 'TestPiCLI|TestPiPluginRuntime' ;;
	openhands) echo 'TestOpenHandsCLI' ;;
	kimi) echo 'TestKimiCLI' ;;
	zcode) echo 'TestZCodeCLI' ;;
	cline) echo 'TestClineCLI' ;;
	grok) echo 'TestGrokCLI' ;;
	copilot) echo 'TestCopilotCLI' ;;
	kiro) echo 'TestKiroCLI' ;;
	mirror) echo 'TestMirrorExtensionRuntime' ;;
	openclaw) echo 'TestOpenClawPluginRuntime' ;;
	amp) echo 'TestAmpPluginRuntime' ;;
	hermes) echo 'TestHermesHookRuntime' ;;
	deepseek) echo 'TestDeepSeekHookRuntime' ;;
	devin) echo 'TestDevinHookRuntime' ;;
	muse) echo 'TestMuseHookRuntime' ;;
	esac
}

run_docker_batch() { # check...
	if ! command -v docker >/dev/null 2>&1; then
		for chk in "$@"; do post "e2e/$chk" failure "docker not found"; done
		return 1
	fi
	combined=""
	for chk in "$@"; do
		rx=$(docker_regex "$chk")
		combined="${combined:+$combined|}$rx"
	done
	echo "== docker e2e ($*)"
	log=$(mktemp)
	vers=$(mktemp)
	set +e
	./scripts/e2e-docker -json -run "^($combined)$" -count=1 >"$log" 2>&1
	drc=$?
	docker run --rm yolonot-e2e:latest bash -lc '
		ver1() { "$@" 2>/dev/null | head -1 | tr -s " " | sed "s/^ *//; s/ *$//" | cut -c1-60; }
		echo "crush=$(ver1 crush --version)"
		echo "goose=goose $(ver1 goose --version)"
		echo "qwen=qwen $(ver1 qwen --version)"
		echo "kilo=kilo $(ver1 kilo --version)"
		echo "pi=pi $(ver1 pi --version)"
		echo "openhands=$(OPENHANDS_SUPPRESS_BANNER=1 openhands --version 2>/dev/null | grep -E "\S" | tail -1 | tr -s " " | sed "s/^ *//; s/ *$//" | cut -c1-60)"
		echo "kimi=kimi $(ver1 kimi --version)"
		echo "zcode=$(ver1 zcode --version)"
		echo "cline=cline $(ver1 cline --version)"
		echo "grok=$(ver1 grok --version)"
		echo "copilot=$(ver1 copilot --version)"
		echo "kiro=$(ver1 kiro-cli-chat --version)"
		echo "mirror=$(ver1 mirror --version)"
		echo "openclaw=$(ver1 openclaw --version)"
		echo "amp=amp $(ver1 amp --version | sed "s/ (released.*//")"
		echo "hermes=hook contract"
		echo "deepseek=hook contract"
		echo "devin=hook contract"
		echo "muse=hook contract"
	' >"$vers" 2>/dev/null
	set -e

	summary=$(mktemp)
	python3 - "$drc" "$log" "$vers" "$@" >"$summary" <<-'PY'
	import json, sys

	drc = int(sys.argv[1])
	log_path, vers_path = sys.argv[2], sys.argv[3]
	checks = sys.argv[4:]

	spec = {
	    "crush": ["TestCrushCLI"],
	    "goose": ["TestGooseCLI"],
	    "qwen": ["TestQwenCLI"],
	    "kilo": ["TestKiloCLI", "TestKiloPluginRuntime"],
	    "pi": ["TestPiCLI", "TestPiPluginRuntime"],
	    "openhands": ["TestOpenHandsCLI"],
	    "kimi": ["TestKimiCLI"],
	    "zcode": ["TestZCodeCLI"],
	    "cline": ["TestClineCLI"],
	    "grok": ["TestGrokCLI"],
	    "copilot": ["TestCopilotCLI"],
	    "kiro": ["TestKiroCLI"],
	    "mirror": ["TestMirrorExtensionRuntime"],
	    "openclaw": ["TestOpenClawPluginRuntime"],
	    "amp": ["TestAmpPluginRuntime"],
	    "hermes": ["TestHermesHookRuntime"],
	    "deepseek": ["TestDeepSeekHookRuntime"],
	    "devin": ["TestDevinHookRuntime"],
	    "muse": ["TestMuseHookRuntime"],
	}

	vers = {}
	with open(vers_path, encoding="utf-8", errors="replace") as vf:
	    for line in vf:
	        if "=" in line:
	            k, v = line.rstrip("\n").split("=", 1)
	            vers[k] = v.strip()

	counts = {c: {"pass": 0, "fail": 0, "skip": 0} for c in checks}
	raw_lines = []
	with open(log_path, encoding="utf-8", errors="replace") as lf:
	    for line in lf:
	        raw_lines.append(line)
	        s = line.strip()
	        if not s.startswith("{"):
	            continue
	        try:
	            ev = json.loads(s)
	        except Exception:
	            continue
	        tname = ev.get("Test", "")
	        act = ev.get("Action", "")
	        if not tname or act not in ("pass", "fail", "skip"):
	            continue
	        for c in checks:
	            if any(tname == p or tname.startswith(p + "/") for p in spec[c]):
	                counts[c][act] += 1

	any_bad = False
	for c in checks:
	    ver = vers.get(c) or c
	    st = counts[c]
	    if st["skip"] > 0:
	        any_bad = True
	        print(f"{c}\tfailure\t{ver}: tests skipped")
	    elif st["fail"] > 0 or st["pass"] == 0 or (drc != 0 and sum(x["fail"] for x in counts.values()) == 0):
	        any_bad = True
	        print(f"{c}\tfailure\t{ver}: e2e failed")
	    else:
	        print(f"{c}\tsuccess\t{ver}: {st['pass']} passed")

	if any_bad:
	    sys.stderr.write("".join(raw_lines[-40:]))
	PY

	brc=0
	while IFS="$(printf '\t')" read -r chk state desc; do
		post "e2e/$chk" "$state" "$desc"
		[ "$state" = success ] || brc=1
	done <"$summary"
	rm -f "$vers" "$summary"
	if [ "$brc" = 0 ]; then
		rm -f "$log"
	else
		echo "full log: $log" >&2
	fi
	return $brc
}

ask() { # prompt → $reply, read from the terminal
	printf '%s' "$1" >/dev/tty
	read -r reply </dev/tty
}

logged() { # file layer:decision → whether the decision log has it for file
	grep -F "$1" "$HOME/.yolonot/decisions.jsonl" 2>/dev/null |
		grep -qF "\"layer\":\"${2%%:*}\",\"decision\":\"${2#*:}\""
}

check() { # file item → status of one Check item from MANUAL.md
	case "$2" in
	"no marker") [ ! -e "$1" ] ;;
	marker) [ -e "$1" ] ;;
	"no log "*) ! logged "$1" "${2#no log }" ;;
	"log "*) logged "$1" "${2#log }" ;;	"see: "*) ask "  ${2#see: } [y/n] "; [ "$reply" = y ] || [ "$reply" = Y ] ;;
	*) echo "unknown check: $2" >&2; return 1 ;;
	esac
}

tty_out() {
	if ( : >/dev/tty ) 2>/dev/null; then
		cat >/dev/tty
	else
		cat >&2
	fi
}

restore() { # harness usual-binary tmp workspace [restore-claude] [had-mod] → put the usual build back
	trap - EXIT INT TERM
	keep_tmp=0
	if [ -f "$3/codex-config.toml.bak" ]; then
		cp "$3/codex-config.toml.bak" "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null || true
	elif [ -f "$3/codex-config.toml.absent" ]; then
		rm -f "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null || true
	fi
	if [ "$1" = claude ] && [ "${6:-1}" = 0 ]; then
		"$3/yolonot" mod uninstall >/dev/null 2>&1 || true
	fi
	if [ "${5:-0}" = 1 ]; then
		if [ -n "$2" ] && "$2" install --harness claude >/dev/null; then
			echo "Restored $2 into your claude hooks." | tty_out
		elif [ -z "$2" ] && "$3/yolonot" uninstall --harness claude >/dev/null; then
			echo "Removed the candidate from your claude hooks." | tty_out
		else
			echo "Could not restore your claude hooks; they still use the candidate kept in $3." | tty_out
			keep_tmp=1
		fi
	fi
	if [ -n "$2" ] && "$2" install --harness "$1" >/dev/null; then
		echo "Restored $2 into your $1 hooks." | tty_out
	elif [ -z "$2" ] && "$3/yolonot" uninstall --harness "$1" >/dev/null; then
		echo "No yolonot on PATH; removed the candidate from your $1 hooks. Reinstall your usual build yourself." | tty_out
	else
		echo "Could not restore your $1 hooks; they still use the candidate kept in $3. Reinstall your usual build, then delete it." | tty_out
		keep_tmp=1
	fi
	[ "$keep_tmp" = 1 ] || rm -rf "$3"
	rm -rf "$4"
}

setup_claude_env_wrapper() { # cand tmp → wraps cand with exported model env_keys for Desktop Explain
	cand_bin=$1 tmp_dir=$2
	wrap="$tmp_dir/yolonot-claude-env"
	python3 - "$cand_bin" "$wrap" "${YOLONOT_DIR:-$HOME/.yolonot}/config.json" <<-'PY'
	import json, os, shlex, sys

	cand, wrap, cfg_path = sys.argv[1], sys.argv[2], sys.argv[3]
	keys = set()
	if os.path.exists(cfg_path):
	    try:
	        cfg = json.load(open(cfg_path, encoding="utf-8"))
	        for m in (cfg.get("models") or {}).values():
	            if isinstance(m, dict) and m.get("env_key"):
	                keys.add(str(m["env_key"]))
	        prov = cfg.get("provider") or {}
	        if isinstance(prov, dict) and prov.get("env_key"):
	            keys.add(str(prov["env_key"]))
	    except Exception:
	        pass
	lines = ["#!/bin/sh"]
	for k in sorted(keys):
	    v = os.environ.get(k, "")
	    if v and k.replace("_", "").isalnum():
	        lines.append(f"export {k}={shlex.quote(v)}")
	lines.append(f'exec {shlex.quote(cand)} "$@"')
	with open(wrap, "w", encoding="utf-8") as wf:
	    wf.write("\n".join(lines) + "\n")
	os.chmod(wrap, 0o700)

	for target in [
	    os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "settings.json"),
	    os.path.join(os.environ.get("YOLONOT_DIR") or os.path.expanduser("~/.yolonot"), "mod", "hooks", "register.tsx"),
	]:
	    if os.path.exists(target):
	        txt = open(target, encoding="utf-8").read()
	        if cand in txt:
	            with open(target, "w", encoding="utf-8") as tf:
	                tf.write(txt.replace(cand, wrap))
	PY
}

trust_codex_hooks_temp() { # tmp ws → backs up ~/.codex/config.toml and trusts candidate hook hashes
	tmp_dir=$1 ws_dir=$2
	command -v codex >/dev/null 2>&1 || return 0
	codex_cfg="${CODEX_HOME:-$HOME/.codex}/config.toml"
	if [ -f "$codex_cfg" ]; then
		cp "$codex_cfg" "$tmp_dir/codex-config.toml.bak"
	else
		mkdir -p "$(dirname "$codex_cfg")"
		: >"$tmp_dir/codex-config.toml.absent"
	fi
	python3 - "$codex_cfg" "$ws_dir" <<-'PY' 2>/dev/null || true
	import json, subprocess, sys

	cfg_path, ws = sys.argv[1], sys.argv[2]
	p = subprocess.Popen(
	    ["codex", "app-server", "--stdio"],
	    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, cwd=ws
	)
	try:
	    p.stdin.write(json.dumps({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "signoff", "version": "1"}, "capabilities": {"experimentalApi": True}}}) + "\n")
	    p.stdin.write(json.dumps({"method": "initialized"}) + "\n")
	    p.stdin.write(json.dumps({"id": 2, "method": "hooks/list", "params": {"cwds": [ws]}}) + "\n")
	    p.stdin.flush()
	    hooks = []
	    for _ in range(30):
	        line = p.stdout.readline()
	        if not line:
	            break
	        msg = json.loads(line)
	        if msg.get("id") == 2 and "result" in msg:
	            data = (msg["result"] or {}).get("data") or []
	            if data:
	                hooks = data[0].get("hooks") or []
	            break
	    if hooks:
	        with open(cfg_path, "a", encoding="utf-8") as cf:
	            for h in hooks:
	                if h.get("key") and h.get("currentHash"):
	                    cf.write(f'\n[hooks.state.{json.dumps(h["key"])}]\ntrusted_hash={json.dumps(h["currentHash"])}\n')
	finally:
	    p.kill()
	PY
}

# manual runs one desktop section: attempts automated macOS UI sign-off first
# (unless --manual is set), falling back to the guided checklist in e2e/MANUAL.md.
manual() { # context harness heading
	ctx=$1 harness=$2 heading=$3
	section=$(awk -v h="## $heading" '$0 == h { on = 1; next } /^## / { on = 0 } on' e2e/MANUAL.md)
	rows=$(printf '%s\n' "$section" | grep -E '^\| [0-9]+ \|')
	[ -n "$rows" ] || { echo "no checklist rows for $heading" >&2; return 1; }
	row_total=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
	tmp=$(mktemp -d)
	chmod 700 "$tmp"
	cand="$tmp/yolonot"
	go build -o "$cand" . || return 1
	ws=$(cd "$(mktemp -d /tmp/yolonot-manual-XXXX)" && pwd -P)
	git -C "$ws" init -q
	printf 'allow-cmd touch *ALLOW*\ndeny-cmd touch *DENY*\nask-cmd touch *ASK*\n' >"$ws/.yolonot"
	usual=$(command -v yolonot || true)
	restore_claude=0
	had_mod=1
	if [ "$harness" = claude ] && [ ! -d "${YOLONOT_DIR:-$HOME/.yolonot}/mod" ]; then
		had_mod=0
	fi
	claude_settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
	if [ "$harness" = cursor ] && grep -q yolonot "$claude_settings" 2>/dev/null; then
		restore_claude=1
	fi

	printf '\n== %s\nWorkspace: %s\nInstalled the candidate into your %s hooks; your usual build is restored when this ends, also on Ctrl+C.\n' \
		"$heading" "$ws" "$harness" | tty_out
	# shellcheck disable=SC2064 # expand the paths now, they are local to this run
	trap "restore '$harness' '$usual' '$tmp' '$ws' '$restore_claude' '$had_mod'" EXIT
	trap 'exit 130' INT TERM
	if [ "$harness" = claude ]; then
		(cd "$ws" && "$cand" install --harness claude --mod) >/dev/null || { restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"; return 1; }
		setup_claude_env_wrapper "$cand" "$tmp"
	else
		(cd "$ws" && "$cand" install --harness "$harness") >/dev/null || { restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"; return 1; }
	fi
	if [ "$restore_claude" = 1 ]; then
		# Cursor imports ~/.claude/settings.json before ~/.cursor/hooks.json;
		# update it to the candidate too so the old system binary is not called.
		(cd "$ws" && "$cand" install --harness claude) >/dev/null || { restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"; return 1; }
	fi
	if [ "$harness" = cursor ]; then
		# Native ask is opt-in by env; a wrapper sets it for the hook only.
		wrap="$tmp/yolonot-cursor-native-ask"
		printf '#!/bin/sh\nYOLONOT_CURSOR_NATIVE_ASK=1 exec "%s" "$@"\n' "$cand" >"$wrap"
		chmod +x "$wrap"
		sed -i '' "s|'$cand' hook|'$wrap' hook|g" "$HOME/.cursor/hooks.json"
	fi
	if [ "$harness" = codex ]; then
		trust_codex_hooks_temp "$tmp" "$ws"
	fi

	case "$harness" in
	claude) app=Claude ;;
	codex) app=ChatGPT ;; # Codex Desktop ships inside the ChatGPT app
	cursor) app=Cursor ;;
	esac
	ver=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "/Applications/$app.app/Contents/Info.plist" 2>/dev/null || true)
	if [ -n "$ver" ]; then
		ver="$app $ver"
		echo "App version: $ver" | tty_out
	fi

	if [ "$force_manual" = 0 ] && [ "$(uname -s)" = Darwin ] && [ -n "$ver" ] && command -v node >/dev/null 2>&1; then
		echo "Running automated desktop sign-off ($harness)..." | tty_out
		set +e
		node scripts/desktop-signoff.mjs "$harness" "$ws" "$tmp"
		auto_rc=$?
		set -e
		if [ "$auto_rc" = 0 ]; then
			restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"
			post "$ctx" success "$ver: $row_total/$row_total rows passed"
			return 0
		fi
		if [ "$auto_rc" != 75 ]; then
			if ( : >/dev/tty ) 2>/dev/null; then
				ask "  Automated run failed (exit $auto_rc). [m]anual guided fallback, or [f]ail? "
				if [ "$reply" != m ] && [ "$reply" != M ]; then
					restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"
					post "$ctx" failure "$ver: automated desktop check failed"
					return 1
				fi
			else
				restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"
				post "$ctx" failure "$ver: automated desktop check failed"
				return 1
			fi
		fi
	fi

	printf '%s\n' "$section" | awk '/^Before:/ { on = 1 } /^\|/ { on = 0 } on' | tty_out
	if [ -n "$ver" ]; then
		# Project rules apply only to sessions working in $ws.
		target=$ws
		# A plain open only focuses the app; these links start a local session in $ws.
		[ "$app" = Claude ] && target="claude://code/new?folder=$ws&source=services"
		[ "$app" = ChatGPT ] && target="codex://new?path=$ws"
		open -a "$app" "$target" && echo "Opened $app on the workspace; use that session for every row." | tty_out
	else
		ask "$app.app not found in /Applications; app version: "
		ver=$reply
		[ -n "$ver" ] || { echo "version required" >&2; restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"; return 1; }
	fi

	failed="" n=0
	# Rows come from a here-document so ask can use the terminal.
	while IFS='|' read -r _ num marker steps checks _; do
		num=$(trim "$num") marker=$(trim "$marker") steps=$(trim "$steps") checks=$(trim "$checks")
		n=$((n + 1)) try=1
		while :; do
			file="$ws/$marker-$try.marker"
			prompt="Use the shell tool exactly once to run this exact command: touch $file . If it is blocked or permission cannot be obtained, stop. Do not retry, use wrappers, or create the file another way."
			# Codex asks only for escalations; a write in the workspace would just run.
			[ "$harness" = codex ] && prompt="$prompt Request escalated permissions."
			printf '%s' "$prompt" | pbcopy 2>/dev/null || true
			printf '\n#%s %s (attempt %s)\nPrompt (copied to the clipboard):\n  %s\n' "$num" "$marker" "$try" "$prompt" >/dev/tty
			rest=$steps step=1
			while [ -n "$rest" ]; do
				case "$rest" in
				*"Then: "*) cur=${rest%%Then: *} rest=${rest#*Then: } ;;
				*) cur=$rest rest="" ;;
				esac
				[ $step -gt 1 ] && rm -f "$file"
				ask "  step $step: $(trim "$cur") [Enter when done] "
				step=$((step + 1))
			done
			sleep 2 # PostToolUse hooks log after the command returns
			ok=1
			items=$(printf '%s\n' "$checks" | tr ';' '\n')
			while read -r c; do
				[ -n "$c" ] || continue
				if check "$file" "$c"; then
					printf '  ✓ %s\n' "$c" >/dev/tty
				else
					printf '  ✗ %s\n' "$c" >/dev/tty
					ok=0
				fi
			done <<ITEMS
$items
ITEMS
			[ $ok = 1 ] && break
			seen=$(grep -F "$file" "$HOME/.yolonot/decisions.jsonl" 2>/dev/null |
				grep -o '"layer":"[^"]*","decision":"[^"]*"' | sed 's/"layer":"//; s/","decision":"/:/; s/"$//')
			printf '    logged for this marker: %s\n' "$(printf '%s' "${seen:-nothing}" | tr '\n' ' ')" >/dev/tty
			cwd=$(grep -F "$file" "$HOME/.yolonot/decisions.jsonl" 2>/dev/null | tail -1 | sed -n 's/.*"cwd":"\([^"]*\)".*/\1/p')
			case "$cwd" in
			"" | "$ws" | "$ws"/*) ;;
			*) printf '    the session runs in %s, not the workspace, so the test rules did not apply;\n    open a session on %s and retry\n' "$cwd" "$ws" >/dev/tty ;;
			esac
			ask "  [r]etry with a fresh marker, or [c]ontinue as failed? "
			[ "$reply" = r ] || { failed="$failed $num"; break; }
			try=$((try + 1))
		done
	done <<EOF
$rows
EOF

	restore "$harness" "$usual" "$tmp" "$ws" "$restore_claude" "$had_mod"
	if [ -n "$failed" ]; then
		post "$ctx" failure "$ver: rows$failed failed"
		return 1
	fi
	post "$ctx" success "$ver: $n/$n rows passed"
}

is_docker_check() {
	case " $DOCKER " in
	*" $1 "*) return 0 ;;
	*) return 1 ;;
	esac
}

for check in "$@"; do
	case " $ALL " in
	*" $check "*) ;;
	*) echo "unknown check $check (checks: $ALL)" >&2; exit 2 ;;
	esac
done

rc=0
if [ -n "$skip" ]; then
	for check in "$@"; do
		case "$check" in
		claude-desktop | codex-desktop | cursor-ide) ctx=manual/$check ;;
		*) ctx=e2e/$check ;;
		esac
		post "$ctx" success "skipped: $skip"
	done
	exit 0
fi

docker_ran=0
docker_queue=""
for check in "$@"; do
	if is_docker_check "$check"; then
		case " $docker_queue " in
		*" $check "*) ;;
		*) docker_queue="${docker_queue:+$docker_queue }$check" ;;
		esac
	fi
done

for check in "$@"; do
	if is_docker_check "$check"; then
		if [ "$docker_ran" = 0 ]; then
			docker_ran=1
			# shellcheck disable=SC2086
			run_docker_batch $docker_queue || rc=1
		fi
		continue
	fi
	echo "== $check"
	case "$check" in
	claude-cli) run_tests "e2e/$check" claude '^(TestClaudeCLI|TestClaudeSkillDiscovery|TestCrossHarnessBinaryE2E)$' ;;
	claude-mod) run_tests "e2e/$check" claude '^(TestClaudeModDialog|TestClaudeModAutoMode)$' ;;
	codex) run_tests "e2e/$check" codex '^(TestCodexExec|TestCodexAppServer|TestCodexSkillDiscovery|TestCrossHarnessBinaryE2E)$' ;;
	opencode) run_tests "e2e/$check" opencode '^(TestOpencodeV2|TestOpencodeSkillDiscovery|TestCrossHarnessBinaryE2E)$' ;;
	agy) run_tests "e2e/$check" agy '^(TestAntigravityCLI|TestAntigravityInteractiveAsk|TestCrossHarnessBinaryE2E)$' ;;
	cursor-cli) run_tests "e2e/$check" cursor-agent '^(TestCursorCLI|TestCursorCLIWithClaudeHooksCoexistence|TestCursorInteractiveAsk|TestCrossHarnessBinaryE2E)$' ;;
	claude-desktop) manual "manual/$check" claude "Claude Desktop" ;;
	codex-desktop) manual "manual/$check" codex "Codex Desktop" ;;
	cursor-ide) manual "manual/$check" cursor "Cursor IDE" ;;
	esac || rc=1
done
exit $rc
