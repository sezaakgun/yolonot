{
  "config_version": 1,
  "models": {
    "chat": {
      "url": "claude-cli",
      "model": "claude-sonnet-5-5",
      "protocol": "claude-cli",
      "timeout": 30
    }
  },
  "judges": [
    "fast_allow",
    "chat"
  ],
  "policy": {
    "profile": "strict"
  },
  "hook_timeout": 45,
  "failure": {
    "unavailable": "deny",
    "parse": "deny",
    "invalid_config": "deny",
    "oversize": "deny",
    "timeout": "deny"
  }
}
